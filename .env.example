# Spotify app credentials — client ID is safe to expose (public)
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id

# Where Spotify sends the user after OAuth — must match your Spotify app dashboard
VITE_SPOTIFY_REDIRECT_URI=http://localhost:3000/callback

# Go backend (deployed on Render)
VITE_BACKEND_URL=https://shufflerionserver.onrender.com

# shufflerionAuth mini-front (deployed on Render/Vercel)
# Guests are sent here to authenticate
VITE_AUTH_FRONT_URL=https://your-shufflerion-auth.onrender.com
